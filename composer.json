{
    "name": "infocyph/arraykit",
    "description": "PHP data and configuration primitives: arrays, collections, dot paths, dotenv, hooks, and DTO hydration.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "array",
        "collection",
        "config",
        "dotenv",
        "dot-notation",
        "dto",
        "pipeline"
    ],
    "authors": [
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-hash": "*"
    },
    "require-dev": {
        "infocyph/phpforge": "dev-main@dev"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\ArrayKit\\": "src/"
        },
        "files": [
            "src/namespaced-functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\ArrayKit\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
